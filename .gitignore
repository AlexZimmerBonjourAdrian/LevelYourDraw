# Archivos a ignorar en el repositorio de Git.
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.log
.DS_Store

# Secretos y configuración local. Nunca al repositorio (ver SECURITY.md).
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
._*

# El brief en docx se genera del markdown con pandoc y vive en Trello, no aca:
# es un binario que ensucia los diffs y se desincroniza de su fuente.
docs/*.docx

# Scripts temporales para desarrollo y debugging
scripts/temp/*.ts
scripts-temp/
debug-scripts/

# Capturas de API para análisis (no versionar, contiene datos de producción)
docs/api-captures/

# Expo - estado local
.expo/
